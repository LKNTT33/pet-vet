<div class="container">
  <div class="row justify-content-center">
    <div class="col-11 col-md-6 mt-2">
      <h1>Pet Profile</h1>

<div class="pet-profile-card">
  <div class="pet-photo-wrapper text-center mb-2">
  <% if @pet.photo.attached? %>
    <%= image_tag @pet.photo, class: "rounded-circle", size: "150x150", alt: "#{@pet.name}'s photo" %>
  <% else %>
    <%= image_tag "paw.png", class: "rounded-circle", size: "150x150", alt: "Default pet image" %>
  <% end %>

  <div class="text-center mt-2">
  <%= link_to edit_pet_path(@pet), class: "btn btn-ghost-main icon-only-btn" do %>
    <i class="fa-solid fa-pen"></i>
  <% end %>
</div>
</div>

  <div class="pet-info-block">
    <p class="mt-4">
      <strong class="pet-info">Name:</strong>
      <%= @pet.name %>
    </p>

    <p>
      <strong class="pet-info">Species:</strong>
      <%= @pet.species == "Other" ? @pet.other_species.presence : @pet.species %>
    </p>

    <p>
      <strong class="pet-info">Age:</strong>
      <%= @pet.age %> years old
    </p>
  </div>

  <div class="pet-action-buttons">
    <% if params[:availability_id].present? %>
      <%= link_to "Select this pet",
                  new_appointment_path(
                    availability_id: params[:availability_id],
                    slot_start: params[:slot_start],
                    slot_end: params[:slot_end],
                    pet_id: @pet.id
                  ),
                  class: "btn btn-flat-main full-width-button" %>
    <% else %>
      <%= link_to "Book an appointment",
                  root_path(pet_id: @pet.id),
                  class: "btn btn-flat-main full-width-button" %>
    <% end %>

     <% if (last_appt = @pet.appointments.order(created_at: :desc).first) %>
      <%= link_to "See Prescriptions", [last_appt, :prescriptions], class: "btn btn-ghost-main" %>
    <% end %>
  </div>
</div>
