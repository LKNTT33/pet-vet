<div class="navbar navbar-expand-sm navbar-light navbar-lewagon">
  <div class="container-fluid">
    <%= link_to "/", class: "navbar-brand" do %>
      <%= image_tag "https://res.cloudinary.com/dvanqdtdy/image/upload/v1756892298/petvet-logo.png" %>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Search for a vet", "/", class: "btn btn-flat-main" %>
          </li>

          <%# Dropdown with avatar %>
          <li class="nav-item dropdown">
            <% avatar_url = current_user.vet? ?
                 "https://res.cloudinary.com/dvanqdtdy/image/upload/v1757575610/PETVET_avatar_vet_bjoh8c.png" :
                 "https://res.cloudinary.com/dvanqdtdy/image/upload/v1757575599/PETVET_avatar_owner_l8hccf.png" %>

            <a href="#" class="avatar" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <%= image_tag avatar_url, class: "avatar", alt: "dropdown menu" %>
            </a>

            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <% if current_user.vet? %>
                <%= link_to "My Profile", vet_profile_path, class: "dropdown-item" %>
                <%= link_to "My Availabilities", new_vet_availability_path(current_user), class: "dropdown-item" %>
                <%= link_to "My Appointments", appointments_path, class: "dropdown-item" %>
              <% else %>
                <%= link_to "My Profile", user_path, class: "dropdown-item" %>
                <%= link_to "My Pets", pets_path, class: "dropdown-item" %>
                <%= link_to "My Appointments", appointments_path, class: "dropdown-item" %>
              <% end %>
              <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
