<h2>Sign up</h2>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: true } }) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <div class="role-radio-group">
      <%= f.input :role,
                  collection: User.roles.keys.map { |r| [r.titleize, r] },
                  as: :radio_buttons,
                  item_wrapper_class: 'role-option',
                  label: "Account Type" %>
    </div>

    <%= f.input :first_name, required: true, autofocus: true %>
    <%= f.input :last_name, required: true %>
    <%= f.input :email, required: true %>
    <%= f.input :password, required: true, hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length) %>
    <%= f.input :password_confirmation, required: true %>

    <turbo-frame id="vet_fields_frame">
      <div id="vet_fields" style="display: none;">
        <%= f.input :specialty %>
        <%= f.input :clinic_name %>
        <%= f.input :city %>
        <%= f.input :phone %>
      </div>
    </turbo-frame>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Sign up" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

<script>
  document.addEventListener("turbo:load", function() {
    const roleRadios = document.querySelectorAll('.role-radio-group input[type="radio"]');
    const vetFields = document.getElementById("vet_fields");

    function toggleVetFields() {
      const selected = Array.from(roleRadios).find(r => r.checked);
      if (selected && selected.value === "vet") {
        vetFields.style.display = "block";
      } else {
        vetFields.style.display = "none";
      }
    }

    toggleVetFields();

    roleRadios.forEach(radio => {
      radio.addEventListener("change", toggleVetFields);
    });
  });
</script>
