<h2>Edit My Profile</h2>

<%= simple_form_for(@user, url: user_path(@user), method: :patch) do |f| %>
  <%= f.input :first_name %>
  <%= f.input :last_name %>
  <%= f.input :city %>
  <%= f.input :phone %>
  <%= f.input :email %>

  <div class="d-flex justify-content-center mt-3">
    <%= f.button :submit, "Save Changes", class:"btn btn-flat-main" %>
  </div>
<% end %>

<div class="d-flex justify-content-center mt-2">
  <%= link_to "← Back to Profile", user_path(@user), class: "link-to-list btn-back" %>
</div>
