<div class="container-user-profile">
  <h2 class="text-center">My Profile</h2>

  <div class="profile-section text-center">
    <h3><strong>👤</strong> <strong><%= @user.first_name %> <%= @user.last_name %></strong></h3>
    <p>Contact:</p>
    <p><strong>📧</strong> <%= @user.email %></p>

    <div class="d-flex justify-content-center mt-5">
      <%= link_to edit_user_path(@vet), class: "btn btn-ghost-main" do %>
    <i class="fa-solid fa-pen"></i>
    <% end %>

    </div>
  </div>

  <div class="profile-section">
    <h3 class="text-center">My Pets 🐾</h3>
    <% if @pets.any? %>
      <ul class="list-unstyled text-center">
        <% @pets.each do |pet| %>
          <li><%= pet.name %> - <%= pet.species %> (Age: <%= pet.age %>)</li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center">No pets yet.</p>
    <% end %>
  </div>

  <div class="profile-section">
    <h3 class="text-center">My Appointments</h3>
    <% if @appointments.any? %>
      <ul class="list-unstyled text-center">
        <% @appointments.each do |appt| %>
          <li>
            <%= appt.availability.start_time.strftime("%d/%m/%Y %H:%M") %> –
            <%= appt.pet.name %> with Vet <strong><%= appt.availability.user.first_name %> <%= appt.availability.user.last_name %></strong>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center">No appointments yet.</p>
    <% end %>
  </div>
</div>
