<h2 class="text-center text-2xl font-bold mb-6">All Vets</h2>

<div class="container">
  <% if @vets.any? %>
    <% @vets.each do |vet| %>
      <div class="row justify-content-center">
        <div class="main-card col-11 col-md-6">
          <div class="row align-items-center">

            <!-- Avatar -->
            <div class="col-12 col-lg-3 text-center mb-3 mb-md-0">
              <%= image_tag "https://res.cloudinary.com/dvanqdtdy/image/upload/v1757575610/PETVET_avatar_vet_bjoh8c.png",
                            alt: "#{vet.first_name} #{vet.last_name}",
                            class: "avatar-card" %>
            </div>

            <!-- Infos -->
            <div class="col-12 col-lg-5 text-lg-start text-center mb-3 mb-md-0">
              <h3 class="font-bold text-lg mb-3">
                <%= link_to "#{vet.first_name} #{vet.last_name}",
                            vet_path(vet),
                            class: "main" %>
              </h3>
              <p class="mb-0"><strong>🧑‍⚕️</strong> <%= vet.specialty %></p>
              <p class="mb-0"><strong>🏥</strong> <%= vet.clinic_name %></p>
              <p><strong>🌎</strong> <%= vet.city %></p>
            </div>

            <!-- Bouton -->
            <div class="col-12 col-lg-4 d-grid">
              <%= link_to "Select this Vet",
                          vet_availabilities_path(vet, pet_id: params[:pet_id]),
                          class: "btn btn-flat-second" %>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="w-full text-center mt-6">
      <p class="text-2xl font-semibold text-gray-700">No results found.</p>
      <%= link_to "Back to Search", root_path, class: "btn btn-flat-main mt-4" %>
    </div>
  <% end %>
</div>
