<div class="vet-edit-page">
  <h2>Edit My Vet Profile</h2>

  <%= simple_form_for(@vet, url: vet_path(@vet), method: :patch, html: { class: "vet-edit-form" }) do |f| %>
    <%= f.input :email %>
    <%= f.input :specialty %>
    <%= f.input :clinic_name %>
    <%= f.input :city %>
    <%= f.input :phone %>

    <div class="d-flex justify-content-center mt-3">
      <%= f.button :submit, "Save Changes", class: "btn btn-flat-main" %>
    </div>
  <% end %>

  <div class="d-flex justify-content-center mt-2">
    <%= link_to "← Back to Profile", vet_profile_path, class: "btn btn-flat-main" %>
  </div>
</div>
