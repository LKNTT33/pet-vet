<h1>Prescriptions for <%= @pet.name %></h1>

<ul class="list-group">
  <% @prescriptions.each do |prescription| %>
    <li class="list-group-item">
      <%= link_to prescription.medicine.name, prescription_path(prescription) %> –

      <% case prescription.medicine.category %>
      <% when "pills" %>
        <%= prescription.dosage.presence || content_tag(:em, "No dosage") %>

      <% when "vaccine" %>
        <%= prescription.date_of_administration.strftime("%d %B %Y") %>
        (<%= pluralize(prescription.immunization_coverage, "year") %>)
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mt-3">
  <%= link_to "← Back to Appointment", appointment_path(@appointment), class: "link-to-list btn-back" %>
</div>
