<h1>Prescription for <%= @pet.name %></h1>

<p><strong>Medicine:</strong> <%= @prescription.medicine.name %></p>
<p><strong>Dosage:</strong> <%= @prescription.dosage %></p>
<p><strong>Instructions:</strong> <%= @prescription.special_instructions %></p>
<p><strong>Start Date:</strong> <%= @prescription.start_date.strftime("%d %B %Y") %></p>
<p><strong>End Date:</strong> <%= @prescription.end_date.strftime("%d %B %Y") %></p>

<%= link_to "← Back to Prescriptions", pet_appointment_prescriptions_path(@pet, @appointment), class: "link-to-list btn-back" %>
