
<h1>Prescription for <%= @prescription.appointment.pet.name %></h1>

<p><strong>Medicine:</strong> <%= @prescription.medicine.name %></p>

<% if @prescription.medicine.category == "pills" %>
  <p><strong>Dosage:</strong> <%= @prescription.dosage %></p>
  <p><strong>Instructions:</strong> <%= @prescription.special_instructions %></p>
  <p><strong>Start Date:</strong> <%= @prescription.start_date.strftime("%d %B %Y") %></p>
  <p><strong>End Date:</strong> <%= @prescription.end_date.strftime("%d %B %Y") %></p>

<% elsif @prescription.medicine.category == "vaccine" %>
  <p><strong>Date of Administration:</strong> <%= @prescription.date_of_administration %></p>
  <p><strong>Immunization Coverage:</strong> <%= pluralize(@prescription.immunization_coverage, "year") %></p>
<% end %>

<%= link_to "← Back to Prescriptions", appointment_prescriptions_path(@prescription.appointment), class: "link-to-list btn-back" %>
