<h1 class="text-2xl font-bold mb-6">Vet Availabilities</h1>
<!-- Date picker -->
<div class="mb-6">
  <%= form_with url: vet_availabilities_path(@vet), method: :get, data: { turbo_frame: "slots" } do |f| %>
    <%= f.date_field :date, value: params[:date] || Date.today, class: "form-input", id: "availability_date_picker" %>
    <%= f.hidden_field :pet_id, value: params[:pet_id] %>
  <% end %>
</div>
<!-- Turbo Frame for slots -->
<%= turbo_frame_tag "slots" do %>
  <% if @slots_for_day.present? %>
    <h2 class="text-xl mb-4">
      Available slots for <%= @selected_date.strftime("%A, %d/%m/%Y") %>
    </h2>
    <div class="availability-day mb-6 p-4 border rounded shadow-sm">
      <ul class="grid grid-cols-4 gap-2">
        <% @slots_for_day.each do |slot| %>
          <% slot_id = "slot_#{slot[:date]}_#{slot[:start].to_i}" %>
          <% if slot[:taken] %>
            <li id="<%= slot_id %>" class="btn btn-disabled text-center">
              <%= slot[:start].strftime("%H:%M") %> - <%= slot[:end].strftime("%H:%M") %>
            </li>
          <% else %>
            <%= link_to "#{slot[:start].strftime("%H:%M")} - #{slot[:end].strftime("%H:%M")}",
                        new_appointment_path(
                          availability_id: slot[:availability_id],
                          slot_start: slot[:start],
                          slot_end: slot[:end],
                          pet_id: params[:pet_id]
                        ),
                        id: slot_id,
                        class: "btn btn-ghost-main w-full text-center" %>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="text-gray-500">No available slots for this day.</p>
  <% end %>
<% end %>
<script>
  // Auto-submit date form when a date is selected
  document.getElementById("availability_date_picker").addEventListener("change", function() {
    this.form.requestSubmit();
  });
</script>
