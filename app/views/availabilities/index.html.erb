<h1 class="text-2xl font-bold mb-6">Vet Availabilities</h1>

<!-- Date picker search form -->
<%= form_with url: vet_availabilities_path(@vet), method: :get, local: true do %>
  <div class="flex items-center gap-2 mb-6">
    <%= date_field_tag :date, params[:date], class: "form-input" %>
    <%= submit_tag "Search by day", class: "btn btn-primary" %>
  </div>
<% end %>

<% if @vet.vet? %>
  <% if @slots_for_day.present? %>
    <h2 class="text-xl mb-4">
      Available slots for <%= @selected_date.strftime("%A, %d/%m/%Y") %>
    </h2>

    <div class="availability-day mb-6 p-4 border rounded shadow-sm">
      <ul class="grid grid-cols-4 gap-2">
        <% @slots_for_day.each do |slot| %>
          <% slot_id = "slot_#{slot[:start].to_i}" %>

          <% if slot[:taken] %>
            <li id="<%= slot_id %>" class="btn btn-disabled text-center">
              <%= slot[:start].strftime("%H:%M") %> - <%= slot[:end].strftime("%H:%M") %>
            </li>
          <% else %>
            <%= link_to "#{slot[:start].strftime("%H:%M")} - #{slot[:end].strftime("%H:%M")}",
                        new_appointment_path(
                          vet_id: @vet.id,
                          availability_id: slot[:availability_id],
                          slot_start: slot[:start],
                          slot_end: slot[:end]
                        ),
                        id: slot_id,
                        class: "btn btn-ghost-main w-full text-center" %>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p class="text-gray-500">No availabilities for this day.</p>
  <% end %>
<% else %>
  <%= render "owner_index" %>
<% end %>
