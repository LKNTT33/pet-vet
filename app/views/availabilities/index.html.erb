<h1 class="text-2xl font-bold mb-6">Vet Availabilities for <%= @vet.first_name %></h1>
<div class="mb-4">
  <!-- Date picker form: submits inside the turbo frame so only slots update -->
  <%= form_with url: vet_availabilities_path(@vet),
                method: :get,
                data: { turbo_frame: "slots" },
                local: true do |f| %>
    <%= f.label :date, "Select a date", class: "sr-only" %>
    <%= f.date_field :date, value: @selected_date, id: "availability_date_picker", class: "form-input" %>
    <%= hidden_field_tag :pet_id, params[:pet_id] if params[:pet_id].present? %>
  <% end %>
</div>

<%# <%= turbo_frame_tag "slots" do %>
  <div id="slots">
  <%= render partial: "availabilities/slots",
             locals: { slots_for_day: @slots_for_day, selected_date: @selected_date, pet_id: params[:pet_id], vet: @vet } %>
  </div>
<%# <% end %>

<script>
  // auto-submit the date form and preserve pet_id in URL (submit triggers turbo frame update)
  document.addEventListener("turbo:load", function() {
    const datePicker = document.getElementById("availability_date_picker")
    if (!datePicker) return
    datePicker.addEventListener("change", function() {
      // submit the form (Turbo will update the "slots" frame)
      this.form.requestSubmit()
    })
  })
</script>
