<div class="availability-edit-container">
  <h1>Manage my availabilities</h1>
  <p>Your weekly working hours (Mon–Fri)</p>

  <div class="availability-form-wrapper">
    <%= turbo_frame_tag "availability_form" do %>
      <%= simple_form_for [@vet, @availability], url: vet_availabilities_path(@vet) do |f| %>
        <%= f.input :day_of_week, collection: Date::DAYNAMES[1..5], prompt: "Select day (Mon–Fri)" %>

        <%= f.input :start_time, as: :string,
                    label: "Start time (HH:MM)",
                    input_html: { data: { controller: "flatpickr", flatpickr_mode: "time" } } %>

        <%= f.input :end_time, as: :string,
                    label: "End time (HH:MM)",
                    input_html: { data: { controller: "flatpickr", flatpickr_mode: "time" } } %>

        <%= f.submit "Save availability", class: "btn btn-flat-main" %>
      <% end %>
    <% end %>
  </div>

  <div class="availability-list-wrapper">
    <h3>Your availabilities</h3>
    <div id="availabilities_list">
      <%= render partial: "availabilities/list", locals: { availabilities: @availabilities, vet: @vet } %>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-3">
    <%= link_to "← Back to Profile", vet_profile_path, class: "btn btn-flat-main" %>
  </div>
</div>
