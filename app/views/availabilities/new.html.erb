<h1>Manage My Availabilities</h1>
<p>Your weekly working hours (Mon–Fri)</p>

<!-- Date picker to pick a week -->
<%= form_with url: new_vet_availability_path(@vet), method: :get, local: true do %>
  <div class="flex items-center gap-2 mb-6">
    <%= date_field_tag :date, params[:date], class: "form-input" %>
    <%= submit_tag "Show Week", class: "btn btn-primary" %>
  </div>
<% end %>

<hr class="my-4">

<h3>Your Availabilities</h3>

<turbo-frame id="availabilities_list">
  <ul class="space-y-2">
    <% %w[Monday Tuesday Wednesday Thursday Friday].each do |day| %>
      <% availability = @availabilities.find { |a| a.start_time&.strftime("%A") == day } %>
      <li class="p-3 border rounded flex justify-between items-center">
        <span>
          <strong><%= day %></strong>:
          <%= availability&.start_time&.strftime("%H:%M") || "09:00" %> -
          <%= availability&.end_time&.strftime("%H:%M") || "17:00" %>
        </span>

        <%= link_to "Delete",
                    availability ? vet_availability_path(@vet, availability) : vet_availabilities_path(@vet),
                    method: availability ? :delete : :post,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "text-red-600 hover:text-red-800 ml-4" %>
      </li>
    <% end %>
  </ul>
</turbo-frame>
