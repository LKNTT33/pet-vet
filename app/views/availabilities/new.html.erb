<h1>Manage My Availabilities</h1>
<p>Add your available working hours</p>

<%= render "form", availability: @availability, vet: @vet %>

<hr>

<h3>Your Availabilities</h3>

<turbo-frame id="availabilities_list">
  <ul>
    <%= render partial: "list_item",
               collection: @availabilities,
               as: :availability,
               locals: { vet: @vet } %>
  </ul>
</turbo-frame>
