<% if slots_for_day.present? %>
  <h2 class="text-xl mb-4">Available slots for <%= selected_date.strftime("%A, %d %B %Y") %></h2>

  <div class="grid grid-cols-4 gap-2">
    <% slots_for_day.each do |slot| %>
      <% id = "slot_#{slot[:availability_id]}_#{slot[:start].to_i}" %>
      <% if slot[:taken] %>
        <div id="<%= id %>" class="btn btn-disabled text-center">
          <%= slot[:start].strftime("%H:%M") %> - <%= slot[:end].strftime("%H:%M") %>
        </div>
      <% else %>
        <%= link_to "#{slot[:start].strftime("%H:%M")} - #{slot[:end].strftime("%H:%M")}",
                    new_appointment_path(
                      availability_id: slot[:availability_id],
                      slot_start: slot[:start],
                      slot_end: slot[:end],
                      pet_id: pet_id
                    ),
                    id: id,
                    class: "btn btn-ghost-main w-full text-center" %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">No available slots for this date.</p>
<% end %>
