<%= simple_form_for @availability, url: vet_availabilities_path(@vet), html: { data: { turbo: true }, id: "availability_form" } do |f| %>
  <%= f.input :day_of_week,
              as: :select,
              collection: %w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday],
              prompt: "Select day",
              label: "Day of the week" %>

  <%= f.input :start_time,
              as: :string,
              label: "Start Time (default 09:00)",
              input_html: { value: @availability.start_time || "09:00", data: { controller: "flatpickr", flatpickr_mode: "time" } } %>

  <%= f.input :end_time,
              as: :string,
              label: "End Time (default 17:00)",
              input_html: { value: @availability.end_time || "17:00", data: { controller: "flatpickr", flatpickr_mode: "time" } } %>

  <%= f.submit "Save Availability", class: "btn btn-flat-main" %>
<% end %>
