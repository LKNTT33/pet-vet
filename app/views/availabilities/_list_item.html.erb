<li id="<%= dom_id(availability) %>" class="mb-4 p-2 border rounded">

  <!-- Availability header -->
  <div class="availability-header flex justify-between items-center">
    <strong>
      <%= availability.date.present? ? availability.date.strftime("%A, %d/%m/%Y") : availability.day_of_week %>
    </strong>

    <span>
      <%= availability.start_time&.strftime("%H:%M") || "?" %> -
      <%= availability.end_time&.strftime("%H:%M") || "?" %>
    </span>

    <%# Only show Delete for vets %>
    <% if current_user == vet %>
      <%= link_to "Delete",
              vet_availability_path(vet, availability),
              data: { turbo_confirm: "Are you sure?", turbo_method: :delete },
              class: "text-red-600 hover:text-red-800 ml-4" %>
    <% end %>
  </div>

  <!-- Slots grid -->
  <div class="slots-grid mt-2 grid grid-cols-4 gap-2">
    <% availability.slots.each do |slot| %>
      <% taken = availability.appointments.any? { |appt| appt.slot_start == slot[:start] } %>
      <% slot_id = "slot_#{availability.id}_#{slot[:start].to_i}" %>

      <div id="<%= slot_id %>">
        <% if taken %>
          <!-- Disabled slot -->
          <span class="btn btn-disabled w-full text-center">
            <%= slot[:start].strftime("%H:%M") %> - <%= slot[:end].strftime("%H:%M") %>
          </span>
        <% else %>
          <!-- Available slot: link to appointment form -->
          <%= link_to "#{slot[:start].strftime("%H:%M")} - #{slot[:end].strftime("%H:%M")}",
                      new_appointment_path(
                        vet_id: vet.id,
                        availability_id: availability.id,
                        slot_start: slot[:start],
                        slot_end: slot[:end]
                      ),
                      class: "btn btn-ghost-main w-full text-center" %>
        <% end %>
      </div>
    <% end %>
  </div>
</li>
